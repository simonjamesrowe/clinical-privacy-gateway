{
  "name": "clinicians-veil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "design-system": "vite --host 127.0.0.1 --port 1420 --open /design-system/",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check package.json package-lock.json tsconfig.json vite.config.ts eslint.config.js index.html src design-system scripts .github/workflows src-tauri/tauri.conf.json src-tauri/capabilities",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "markdown-it": "15.0.2",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.8",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tauri-apps/cli": "2.11.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jsdom": "30.1.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
